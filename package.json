{
  "name": "@sasjs/cli",
  "description": "Command line interface for SASjs",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "files": [
    "build/**/*"
  ],
  "scripts": {
    "start:ci": "npm run build && npm run set:permissions",
    "start": "nodemon --watch \"src/**/*\" --exec \"npm run build && npm run set:permissions\"",
    "set:permissions": "node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "build": "npx rimraf build && tsc -p . && npm run copy:files",
    "copy:files": "copyfiles -u 1 ./src/config.json ./build/ && npm run copy:doxy && npm run copy:mock",
    "copy:doxy": "copyfiles -u 2 src/doxy/* build/doxy/",
    "copy:mock": "copyfiles -u 6 src/commands/build/internal/mockSite/assets/* build/commands/build/internal/mockSite/assets/",
    "test": "npm run test:mocked && npm run test:server",
    "test:server": "jest --silent --runInBand --config=jest.server.config.js",
    "test:mocked": "jest --silent --runInBand --config=jest.config.js --coverage",
    "lint:fix": "npx prettier --write \"{src,test}/**/*.{ts,tsx,js,jsx,html,css,sass,less,yml,md,graphql}\"",
    "lint": "npx prettier --check \"{src,test}/**/*.{ts,tsx,js,jsx,html,css,sass,less,yml,md,graphql}\"",
    "doc": "npx compodoc -p tsconfig.doc.json --coverageTest 16 --coverageTestThresholdFail"
  },
  "testServerTypes": "sasjs",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "publishCmd": "npm publish --provenance --access public"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "bin": {
    "sasjs": "build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/cli.git"
  },
  "keywords": [
    "SAS",
    "Viya",
    "SASjs"
  ],
  "author": "4GL Apps",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sasjs/cli/issues"
  },
  "homepage": "https://cli.sasjs.io",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@sasjs/adapter": "^5.1.1",
    "@sasjs/core": "^6.1.1",
    "@sasjs/lint": "4.9.0",
    "@sasjs/utils": "^4.1.2",
    "axios": "1.20.0",
    "chalk": "4.1.2",
    "dotenv": "18.0.8",
    "js-base64": "3.9.4",
    "jsdom": "26.0.0",
    "lodash.uniqby": "4.7.0",
    "node-graphviz": "0.1.1",
    "node-powershell": "5.0.1",
    "ora": "9.4.1",
    "prompts": "2.4.2",
    "ssl-root-cas": "1.3.1",
    "xml": "1.0.1",
    "yargs": "17.6.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@nogoo9/gitleaks": "8.30.1-post.2",
    "@types/debug": "4.1.13",
    "@types/find": "0.2.4",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.1",
    "@types/lodash.uniqby": "4.7.9",
    "@types/node": "22.10.2",
    "@types/prompts": "2.4.9",
    "@types/url-parse": "1.4.11",
    "@types/xml": "1.0.11",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "babel-jest": "30.5.2",
    "copyfiles": "2.4.1",
    "jest": "30.5.2",
    "jest-cli": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "7.0.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "util": "0.12.5"
  },
  "overrides": {
    "ws": "8.21.0",
    "nanoid": "3.3.18"
  }
}
